{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START V5 MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END V5 MACROS\n\n\n// Robot configuration code.\nmotor leftMotorA = motor(PORT1, ratio18_1, true);\nmotor leftMotorB = motor(PORT2, ratio18_1, true);\nmotor_group LeftDriveSmart = motor_group(leftMotorA, leftMotorB);\nmotor rightMotorA = motor(PORT12, ratio18_1, false);\nmotor rightMotorB = motor(PORT11, ratio18_1, false);\nmotor_group RightDriveSmart = motor_group(rightMotorA, rightMotorB);\ninertial DrivetrainInertial = inertial(PORT18);\nsmartdrive Drivetrain = smartdrive(LeftDriveSmart, RightDriveSmart, DrivetrainInertial, 219.44, 320, 40, mm, 0.5714285714285714);\n\ncontroller Controller1 = controller(primary);\nmotor LiftMotorA = motor(PORT3, ratio18_1, true);\nmotor LiftMotorB = motor(PORT13, ratio18_1, false);\nmotor_group Lift = motor_group(LiftMotorA, LiftMotorB);\n\nmotor claw = motor(PORT21, ratio18_1, false);\n\nmotor Spinclaw = motor(PORT20, ratio18_1, false);\n\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  int systemTime = Brain.Timer.systemHighResolution();\n  double batteryCurrent = Brain.Battery.current();\n  double batteryVoltage = Brain.Battery.voltage(voltageUnits::mV);\n\n  // Combine these values into a single integer\n  int seed = int(batteryVoltage + batteryCurrent * 100) + systemTime;\n\n  // Set the seed\n  srand(seed);\n}\n\nbool vexcode_initial_drivetrain_calibration_completed = false;\nvoid calibrateDrivetrain() {\n  wait(200, msec);\n  Brain.Screen.print(\"Calibrating\");\n  Brain.Screen.newLine();\n  Brain.Screen.print(\"Inertial\");\n  DrivetrainInertial.calibrate();\n  while (DrivetrainInertial.isCalibrating()) {\n    wait(25, msec);\n  }\n  vexcode_initial_drivetrain_calibration_completed = true;\n  // Clears the screen and returns the cursor to row 1, column 1.\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1, 1);\n}\n\nvoid vexcodeInit() {\n\n  // Calibrate the Drivetrain\n  calibrateDrivetrain();\n\n  //Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// Helper to make playing sounds from the V5 in VEXcode easier and\n// keeps the code cleaner by making it clear what is happening.\nvoid playVexcodeSound(const char *soundName) {\n  printf(\"VEXPlaySound:%s\\n\", soundName);\n  wait(5, msec);\n}\n\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n// define variables used for controlling motors based on controller inputs\nbool Controller1LeftShoulderControlMotorsStopped = true;\nbool DrivetrainLNeedsToBeStopped_Controller1 = true;\nbool DrivetrainRNeedsToBeStopped_Controller1 = true;\n\n// define a task that will handle monitoring inputs from Controller1\nint rc_auto_loop_function_Controller1() {\n  // process the controller input every 20 milliseconds\n  // update the motors based on the input values\n  while(true) {\n    if(RemoteControlCodeEnabled) {\n      // stop the motors if the brain is calibrating\n      if (DrivetrainInertial.isCalibrating()) {\n        LeftDriveSmart.stop();\n        RightDriveSmart.stop();\n        while (DrivetrainInertial.isCalibrating()) {\n          wait(25, msec);\n        }\n      }\n      \n      // calculate the drivetrain motor velocities from the controller joystick axies\n      // left = Axis3 + Axis1\n      // right = Axis3 - Axis1\n      int drivetrainLeftSideSpeed = Controller1.Axis3.position() + Controller1.Axis1.position();\n      int drivetrainRightSideSpeed = Controller1.Axis3.position() - Controller1.Axis1.position();\n      \n      // check if the value is inside of the deadband range\n      if (drivetrainLeftSideSpeed < 5 && drivetrainLeftSideSpeed > -5) {\n        // check if the left motor has already been stopped\n        if (DrivetrainLNeedsToBeStopped_Controller1) {\n          // stop the left drive motor\n          LeftDriveSmart.stop();\n          // tell the code that the left motor has been stopped\n          DrivetrainLNeedsToBeStopped_Controller1 = false;\n        }\n      } else {\n        // reset the toggle so that the deadband code knows to stop the left motor nexttime the input is in the deadband range\n        DrivetrainLNeedsToBeStopped_Controller1 = true;\n      }\n      // check if the value is inside of the deadband range\n      if (drivetrainRightSideSpeed < 5 && drivetrainRightSideSpeed > -5) {\n        // check if the right motor has already been stopped\n        if (DrivetrainRNeedsToBeStopped_Controller1) {\n          // stop the right drive motor\n          RightDriveSmart.stop();\n          // tell the code that the right motor has been stopped\n          DrivetrainRNeedsToBeStopped_Controller1 = false;\n        }\n      } else {\n        // reset the toggle so that the deadband code knows to stop the right motor next time the input is in the deadband range\n        DrivetrainRNeedsToBeStopped_Controller1 = true;\n      }\n      \n      // only tell the left drive motor to spin if the values are not in the deadband range\n      if (DrivetrainLNeedsToBeStopped_Controller1) {\n        LeftDriveSmart.setVelocity(drivetrainLeftSideSpeed, percent);\n        LeftDriveSmart.spin(forward);\n      }\n      // only tell the right drive motor to spin if the values are not in the deadband range\n      if (DrivetrainRNeedsToBeStopped_Controller1) {\n        RightDriveSmart.setVelocity(drivetrainRightSideSpeed, percent);\n        RightDriveSmart.spin(forward);\n      }\n      // check the ButtonL1/ButtonL2 status to control claw\n      if (Controller1.ButtonL1.pressing()) {\n        claw.spin(forward);\n        Controller1LeftShoulderControlMotorsStopped = false;\n      } else if (Controller1.ButtonL2.pressing()) {\n        claw.spin(reverse);\n        Controller1LeftShoulderControlMotorsStopped = false;\n      } else if (!Controller1LeftShoulderControlMotorsStopped) {\n        claw.stop();\n        // set the toggle so that we don't constantly tell the motor to stop when the buttons are released\n        Controller1LeftShoulderControlMotorsStopped = true;\n      }\n    }\n    // wait before repeating the process\n    wait(20, msec);\n  }\n  return 0;\n}\n\ntask rc_auto_loop_task_Controller1(rc_auto_loop_function_Controller1);\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n/*----------------------------------------------------------------------------*/\n/*                                                                            */\n/*    Module:       main.cpp                                                  */\n/*    Author:       LincFPV                                                   */\n/*    Description:  93601V Override comp code for the old drivetrain robot    */\n/*                  (CompV2 competition layout + drivetrain.v5cpp hardware)   */\n/*                                                                            */\n/*    Auton plan (one robot, 20 points):                                      */\n/*      1. Put the preload in our alliance goal, yellow half up.              */\n/*      2. Push our quadrant's toggle to our colour.                          */\n/*      Toggle set = preload yellow half (10) + neutral goal's yellow pin     */\n/*      half (10). Win the auton on points and we also get the 12 pt bonus.   */\n/*                                                                            */\n/*----------------------------------------------------------------------------*/\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// A global instance of competition\ncompetition Competition;\n\n/*----------------------------------------------------------------------------*/\n/*                         MEASURE THESE ON YOUR ROBOT                        */\n/*                                                                            */\n/*  The routes will NOT run until ROBOT_IS_TUNED is true. The TEST button on  */\n/*  the Brain always runs. Driver control shows live lift and claw degrees    */\n/*  on the Brain screen, so use that to read the LIFT_ and CLAW_ numbers.     */\n/*----------------------------------------------------------------------------*/\nconst bool ROBOT_IS_TUNED = true;\n\n// Robot size, in mm. Measure from the middle of the drivetrain (the spot the\n// robot spins around).\nconst double BACK_TO_CENTER_MM  = 242;  // to the rear bumper\nconst double FRONT_TO_CENTER_MM = 206;  // to the front bumper\nconst double CLAW_REACH_MM      = 160;  // to the middle of a pin held in the claw\n\n// Lift heights, in motor degrees, with 0 = lift all the way down.\nconst double LIFT_CARRY_DEG  = 300;  // bottom of the pin is ~20 mm above the 83 mm goal\nconst double LIFT_PLACE_DEG  = 200;  // bottom of the pin is just inside the goal\nconst double LIFT_TOGGLE_DEG = 900;  // claw is 320 mm off the floor (see toggle note)\n\n// Claw\nconst directionType CLAW_CLOSE_DIR = forward;  // driver L1\nconst directionType CLAW_OPEN_DIR  = reverse;  // driver L2\nconst double CLAW_OPEN_DEG = 120;  // how far to open so the claw clears the pin\n\n// Drive calibration. Use the TEST button, then:\n//   DRIVE_SCALE = DRIVE_SCALE * (the mm the robot really drove / 600)\n//   TURN_SCALE  = TURN_SCALE  * (the degrees the robot really turned / 90)\ndouble DRIVE_SCALE = 1.0;\ndouble TURN_SCALE  = 1.0;  // only used when the inertial sensor is not plugged in\n\n// Speeds, in percent\nconst double DRIVE_PCT = 85;\nconst double TURN_PCT  = 60;\nconst double BUMP_PCT  = 30;  // final slow push into the toggle\n\n/*----------------------------------------------------------------------------*/\n/*                  FIELD NUMBERS - from the Override manual                  */\n/*----------------------------------------------------------------------------*/\nconst double WALL_TO_GOAL_ROW_MM = 585;   // wall to the row our alliance goal is in\nconst double TILE_MM             = 600;   // our goal is 1 tile from the wall's centre line\nconst double BUMP_SLOW_ZONE_MM   = 150;   // slow down this far before the wall\nconst double BACK_OFF_MM         = 300;   // get clear of the toggle and the wall\nconst int    LATEST_BACK_OFF_MS  = 13500; // always let go of the toggle by this time\n\n/*----------------------------------------------------------------------------*/\n/*                 Drivetrain numbers from your robot config                  */\n/*----------------------------------------------------------------------------*/\nconst double WHEEL_TRAVEL_MM = 219.44;  // 2.75 in wheel\nconst double GEAR_RATIO      = 48.0 / 84.0;\nconst double TRACK_WIDTH_MM  = 295;\nconst double PI_VALUE        = 3.14159265358979;\n\nenum autonRoute { ROUTE_NONE, ROUTE_RED_LEFT_BLUE_RIGHT, ROUTE_RED_BOTTOM_BLUE_TOP, ROUTE_TEST };\nautonRoute selectedRoute = ROUTE_NONE;\n\ntimer autonTimer;\ndouble targetHeading = 0;  // the way the robot should point, clockwise is positive\n\n/*----------------------------------------------------------------------------*/\n/*                               Helper functions                             */\n/*----------------------------------------------------------------------------*/\ndouble clampValue(double value, double low, double high) {\n  if (value < low) return low;\n  if (value > high) return high;\n  return value;\n}\n\ndouble motorDegToMm(double motorDeg) {\n  return motorDeg / 360.0 * GEAR_RATIO * WHEEL_TRAVEL_MM * DRIVE_SCALE;\n}\n\ndouble leftMm()  { return motorDegToMm(LeftDriveSmart.position(degrees)); }\ndouble rightMm() { return motorDegToMm(RightDriveSmart.position(degrees)); }\n\nbool gyroReady() {\n  return DrivetrainInertial.installed() && !DrivetrainInertial.isCalibrating();\n}\n\n// Uses the inertial sensor if it is plugged in, otherwise the motor encoders.\ndouble currentHeading() {\n  if (gyroReady()) return DrivetrainInertial.rotation(degrees);\n  double arcMm = (leftMm() - rightMm()) / 2.0;\n  return arcMm / (PI_VALUE * TRACK_WIDTH_MM / 360.0) * TURN_SCALE;\n}\n\nvoid setDrive(double leftPct, double rightPct) {\n  LeftDriveSmart.spin(forward, leftPct, percent);\n  RightDriveSmart.spin(forward, rightPct, percent);\n}\n\nvoid stopDrive() {\n  LeftDriveSmart.stop(brake);\n  RightDriveSmart.stop(brake);\n  wait(60, msec);\n}\n\n// Drives straight. Negative mm drives backwards. Never runs past timeoutMs, so\n// getting stuck can't use up the whole auton. Set stopOnStall to end the drive\n// as soon as the robot stops moving (for pushing into the wall).\nvoid driveMm(double mm, double maxPct, int timeoutMs, bool stopOnStall = false) {\n  double startLeft = leftMm();\n  double startRight = rightMm();\n  double direction = (mm < 0) ? -1 : 1;\n  double distance = fabs(mm);\n  int elapsed = 0;\n  int stalledMs = 0;\n\n  while (elapsed < timeoutMs && autonTimer.time(msec) < 14900) {\n    double traveled = (fabs(leftMm() - startLeft) + fabs(rightMm() - startRight)) / 2.0;\n    double remaining = distance - traveled;\n    if (remaining <= 2) break;\n\n    // Ramp up at the start and slow down at the end so the wheels don't slip.\n    double speed = maxPct;\n    speed = fmin(speed, 25 + traveled * 0.5);\n    speed = fmin(speed, 12 + remaining * 0.35);\n\n    double correction = clampValue((targetHeading - currentHeading()) * 2.0, -15, 15);\n    setDrive(direction * speed + correction, direction * speed - correction);\n\n    if (stopOnStall && elapsed > 300) {\n      bool stopped = fabs(LeftDriveSmart.velocity(percent)) < 4 &&\n                     fabs(RightDriveSmart.velocity(percent)) < 4;\n      stalledMs = stopped ? stalledMs + 10 : 0;\n      if (stalledMs >= 150) break;\n    }\n\n    wait(10, msec);\n    elapsed += 10;\n  }\n  stopDrive();\n}\n\n// Turns on the spot. Positive is clockwise (right).\nvoid turnDeg(double degreesToTurn, int timeoutMs) {\n  targetHeading += degreesToTurn;\n  int elapsed = 0;\n  int settledMs = 0;\n\n  while (elapsed < timeoutMs && autonTimer.time(msec) < 14900) {\n    double error = targetHeading - currentHeading();\n    if (fabs(error) < 1.5) {\n      settledMs += 10;\n      if (settledMs >= 60) break;\n    } else {\n      settledMs = 0;\n    }\n    double speed = clampValue(fabs(error) * 1.2, 7, TURN_PCT);\n    double signedSpeed = (error > 0) ? speed : -speed;\n    setDrive(signedSpeed, -signedSpeed);\n    wait(10, msec);\n    elapsed += 10;\n  }\n  stopDrive();\n}\n\nvoid moveLift(double liftDeg) {\n  Lift.spinToPosition(liftDeg, degrees, 100, velocityUnits::pct, false);\n}\n\nvoid waitForLift(double liftDeg, int timeoutMs) {\n  int elapsed = 0;\n  while (fabs(Lift.position(degrees) - liftDeg) > 8 && elapsed < timeoutMs) {\n    wait(10, msec);\n    elapsed += 10;\n  }\n}\n\nvoid gripPreload() {\n  claw.setMaxTorque(100, percent);\n  claw.spin(CLAW_CLOSE_DIR, 8, volt);\n  wait(250, msec);\n  claw.stop(hold);\n  claw.setPosition(0, degrees);\n}\n\nvoid releaseClaw() {\n  double target = (CLAW_OPEN_DIR == reverse) ? -CLAW_OPEN_DEG : CLAW_OPEN_DEG;\n  claw.spin(CLAW_OPEN_DIR, 8, volt);\n  int elapsed = 0;\n  while (fabs(claw.position(degrees) - target) > 5 && elapsed < 500) {\n    wait(10, msec);\n    elapsed += 10;\n  }\n  claw.stop(hold);\n}\n\n/*----------------------------------------------------------------------------*/\n/*                                 Auton route                                */\n/*                                                                            */\n/*  Start: rear bumper flat on the wall, centred on the toggle (the middle of */\n/*  the wall), facing the field. Preload sits in the claw with YELLOW UP.     */\n/*                                                                            */\n/*  Toggle note: from the manual's start position, the field side of a toggle */\n/*  on our half of the field has to roll DOWN towards the wall to reach our   */\n/*  colour. That takes ONE stroke. Pushing below the toggle's axle does this, */\n/*  and 320 mm off the floor is just above the wall and below the axle.       */\n/*                                                                            */\n/*  The robot never crosses the autonomous line on these routes.              */\n/*----------------------------------------------------------------------------*/\nvoid runWallRoute(double turnSide) {  // +1 = goal is to the right, -1 = to the left\n  double firstLegMm = WALL_TO_GOAL_ROW_MM - BACK_TO_CENTER_MM;\n  double goalLegMm = TILE_MM - CLAW_REACH_MM;\n  double wallGapMm = WALL_TO_GOAL_ROW_MM - FRONT_TO_CENTER_MM;\n\n  // 1. Grab the preload and lift it above the goal while driving out.\n  gripPreload();\n  moveLift(LIFT_CARRY_DEG);\n  driveMm(firstLegMm, DRIVE_PCT, 2200);\n\n  // 2. Turn to face our alliance goal and drive up to it.\n  turnDeg(90 * turnSide, 1100);\n  waitForLift(LIFT_CARRY_DEG, 500);\n  driveMm(goalLegMm, DRIVE_PCT, 1800);\n\n  // 3. Lower the pin into the goal and let go.\n  moveLift(LIFT_PLACE_DEG);\n  waitForLift(LIFT_PLACE_DEG, 500);\n  releaseClaw();\n  wait(120, msec);\n\n  // 4. Back straight out so the open claw slides off the pin, then face the wall.\n  driveMm(-goalLegMm, DRIVE_PCT, 1800);\n  moveLift(LIFT_TOGGLE_DEG);\n  turnDeg(90 * turnSide, 1100);\n  waitForLift(LIFT_TOGGLE_DEG, 1800);\n\n  // 5. Drive at the wall, then slowly push the toggle over.\n  driveMm(wallGapMm - BUMP_SLOW_ZONE_MM, DRIVE_PCT, 1400);\n  int pushTimeMs = LATEST_BACK_OFF_MS - (int)autonTimer.time(msec);\n  if (pushTimeMs > 0) {\n    driveMm(BUMP_SLOW_ZONE_MM + 30, BUMP_PCT, (int)fmin(pushTimeMs, 1800), true);\n  }\n\n  // 6. Back away. A toggle only counts once nothing is touching it.\n  driveMm(-BACK_OFF_MM, DRIVE_PCT, 1100);\n  moveLift(0);\n}\n\n// Run this from the TEST button to set DRIVE_SCALE and TURN_SCALE.\nvoid runDriveTest() {\n  driveMm(600, DRIVE_PCT, 4000);\n  wait(1500, msec);\n  turnDeg(90, 2000);\n}\n\n/*----------------------------------------------------------------------------*/\n/*                           Route picker on the Brain                        */\n/*----------------------------------------------------------------------------*/\nvoid drawPicker() {\n  const char *names[3] = {\"RED LEFT or BLUE RIGHT\", \"RED BOTTOM or BLUE TOP\", \"TEST: 1 tile, 90 deg\"};\n  autonRoute routes[3] = {ROUTE_RED_LEFT_BLUE_RIGHT, ROUTE_RED_BOTTOM_BLUE_TOP, ROUTE_TEST};\n\n  Brain.Screen.clearScreen();\n  for (int i = 0; i < 3; i++) {\n    bool picked = (selectedRoute == routes[i]);\n    Brain.Screen.setFillColor(picked ? green : black);\n    Brain.Screen.setPenColor(white);\n    Brain.Screen.drawRectangle(10, 10 + i * 60, 460, 50);\n    Brain.Screen.printAt(25, 42 + i * 60, false, \"%s\", names[i]);\n  }\n  Brain.Screen.setFillColor(black);\n  Brain.Screen.setPenColor(white);\n  if (!ROBOT_IS_TUNED) {\n    Brain.Screen.printAt(10, 205, \"NOT TUNED: only TEST will run\");\n  } else if (selectedRoute == ROUTE_NONE) {\n    Brain.Screen.printAt(10, 205, \"TAP A ROUTE OR AUTON DOES NOTHING\");\n  } else {\n    Brain.Screen.printAt(10, 205, false, \"Ready. Gyro: %s\", DrivetrainInertial.installed() ? \"yes\" : \"NOT FOUND\");\n  }\n}\n\nvoid checkPickerTouch() {\n  if (Brain.Screen.pressing()) {\n    int y = Brain.Screen.yPosition();\n    if (y >= 10 && y < 60) selectedRoute = ROUTE_RED_LEFT_BLUE_RIGHT;\n    else if (y >= 70 && y < 120) selectedRoute = ROUTE_RED_BOTTOM_BLUE_TOP;\n    else if (y >= 130 && y < 180) selectedRoute = ROUTE_TEST;\n    drawPicker();\n    while (Brain.Screen.pressing()) {\n      wait(20, msec);\n    }\n  }\n}\n\nvoid runPicker() {\n  drawPicker();\n  while (!Competition.isEnabled()) {\n    checkPickerTouch();\n    wait(20, msec);\n  }\n}\n\n// True only when no field or competition switch is plugged in.\nbool onTheBench() {\n  return !Competition.isFieldControl() && !Competition.isCompetitionSwitch();\n}\n\n/*----------------------------------------------------------------------------*/\n/*                          Competition functions                             */\n/*----------------------------------------------------------------------------*/\nvoid pre_auton(void) {\n  // Initializing Robot Configuration. DO NOT REMOVE!\n  // This calibrates the inertial sensor, so keep the robot still when it starts.\n  vexcodeInit();\n  Lift.setStopping(hold);\n  Lift.setVelocity(100, percent);\n  Lift.setMaxTorque(100, percent);\n  Lift.setPosition(0, degrees);  // lift must be all the way down at program start\n  claw.setStopping(hold);\n  claw.setVelocity(100, percent);\n  Spinclaw.setStopping(hold);\n  Spinclaw.setVelocity(40, percent);\n  Spinclaw.setTimeout(1, seconds);\n  runPicker();\n}\n\nvoid autonomous(void) {\n  RemoteControlCodeEnabled = false;  // nothing from the controller during auton\n  autonTimer.clear();\n  targetHeading = 0;\n  LeftDriveSmart.setPosition(0, degrees);\n  RightDriveSmart.setPosition(0, degrees);\n  if (gyroReady()) DrivetrainInertial.setRotation(0, degrees);\n  Lift.setPosition(0, degrees);\n  Spinclaw.stop(hold);\n\n  if (selectedRoute == ROUTE_TEST) {\n    runDriveTest();\n  } else if (ROBOT_IS_TUNED && selectedRoute == ROUTE_RED_LEFT_BLUE_RIGHT) {\n    runWallRoute(1);\n  } else if (ROBOT_IS_TUNED && selectedRoute == ROUTE_RED_BOTTOM_BLUE_TOP) {\n    runWallRoute(-1);\n  }\n\n  stopDrive();\n  Brain.Screen.clearScreen();\n  Brain.Screen.printAt(10, 40, \"Auton took %.1f s\", autonTimer.time(sec));\n}\n\nvoid usercontrol(void) {\n  RemoteControlCodeEnabled = true;\n\n  // --- drivetrain stuff ---\n  Drivetrain.setDriveVelocity(100, percent); // Drivetrain speed\n  Drivetrain.setTurnVelocity(100, percent);  // Drivetrain turning speed\n\n  // --- lift stuff ---\n  Lift.setStopping(hold);          // tells the lift to not fall down and stay in one place\n  Lift.setVelocity(100, percent);  // makes lift fast and functional\n  Lift.setMaxTorque(100, percent); // makes lift go up with strength\n\n  int screenCounter = 0;\n  drawPicker();\n  while (1) {\n    // Bench testing only: tap a route on the Brain, then press A to run auton.\n    // This can't run in a match because it needs no field to be plugged in.\n    if (onTheBench()) {\n      checkPickerTouch();\n      if (Controller1.ButtonA.pressing()) {\n        autonomous();\n        RemoteControlCodeEnabled = true;\n        wait(2, seconds);\n        drawPicker();\n      }\n    }\n\n    if (Controller1.ButtonR1.pressing()) {\n      Lift.spin(forward, 12, volt); // lift uppy\n    } else if (Controller1.ButtonR2.pressing()) {\n      Lift.spin(reverse, 12, volt); // lift downy\n    } else {\n      Lift.stop(hold);\n    }\n\n    if (Controller1.ButtonRight.pressing()) {\n      Spinclaw.spinFor(forward, 180, degrees); // spinclaw spin right macro\n    } else if (Controller1.ButtonLeft.pressing()) {\n      Spinclaw.spinFor(reverse, 180, degrees); // spin claw spin left macro\n    } else if (Controller1.ButtonUp.pressing()) {\n      Spinclaw.spin(forward); // Spin claw spin right non-macro\n    } else if (Controller1.ButtonDown.pressing()) {\n      Spinclaw.spin(reverse); // spin claw spin left non-macro\n    } else {\n      Spinclaw.stop(hold);\n    }\n\n    // Live numbers for filling in the LIFT_ and CLAW_ values at the top.\n    screenCounter++;\n    if (screenCounter >= 10) {\n      screenCounter = 0;\n      Brain.Screen.printAt(10, 232, true, \"Lift %.0f deg   Claw %.0f deg     \", Lift.position(degrees), claw.position(degrees));\n    }\n\n    wait(20, msec); // Sleep the task for a short amount of time to\n                    // prevent wasted resources.\n  }\n}\n\n// Main will set up the competition functions and callback.\nint main() {\n  // Set up callbacks for autonomous and driver control periods.\n  Competition.autonomous(autonomous);\n  Competition.drivercontrol(usercontrol);\n\n  // Run the pre-autonomous function.\n  pre_auton();\n\n  // Prevent main from exiting with an infinite loop.\n  while (true) {\n    wait(100, msec);\n  }\n}\n","textLanguage":"cpp","robotConfig":[{"port":[1,2,12,11,18],"name":"Drivetrain","customName":false,"deviceType":"Drivetrain","deviceClass":"smartdrive","setting":{"type":"4-motor","wheelSize":"wheel275in","gear":"ratio18_1","gearRatio":"48:84","direction":"rev","gyroType":"inertial","width":"295","unit":"mm","wheelbase":"40","wheelbaseUnit":"mm","xOffset":"0","xOffsetUnit":"mm","yOffset":"0","yOffsetUnit":"mm","thetaOffset":"180"},"triportSourcePort":null},{"port":[],"name":"Controller1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"claw","leftDir":"false","right":"","rightDir":"true","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"split","id":"primary"},"triportSourcePort":22},{"port":[3,13],"name":"Lift","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","gear":"ratio18_1","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[21],"name":"claw","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[20],"name":"Spinclaw","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22}],"slot":1,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}